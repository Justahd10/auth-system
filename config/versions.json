        "isCritical": true
      },
      "redis": {
        "isCritical": true
      },
      "email": {
        "isCritical": true,
        "service": "gmail"
      }
    },
    "domainServices": {
      "auth": {
        "enabled": true,
        "disabledMethods": [
          "DELETE", "PATCH"
        ],
        "disabledEndpoints": [
          "/api/auth/me"
        ]
      },
      "health": {
        "enabled": true,
        "disabledMethods": [
          "DELETE", "PATCH"
        ],
        "disabledEndpoints": [
          "/api/auth/me"
        ]
      }
    }
  },

  "prod": {
    
  }
}