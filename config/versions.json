{
  "dev": {
    "http": {
      "port": 3002,
      "rateLimit": 5
    },
    "proxy": {},
    "cookiesSession": {
      "name": "session",
      "signed": false
    },
    "corsFormat": {
      "origins": [
        "http://localhost:5137"
      ],
      "credentials": true
    },
    "clients": {
