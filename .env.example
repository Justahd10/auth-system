# JWT
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTHTOKEN_ISSUER=auth-system

# Email (Gmail app password)
SERVICE_EMAIL_FROM=replace-with-the-sender-address
SERVICE__EMAIL_APP_PASSWORD=replace-with-a-gmail-app-password

# PostgreSQL connection string
SERVICE_DB_CONNECTION=postgres://user:password@localhost:5432/auth_system

# Redis connection
SERVICE_REDIS_URL="redis://host:port"
SERVICE_REDIS_USER=
SERVICE_REDIS_PASSWORD=