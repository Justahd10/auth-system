# JWT
TOKEN_SECRET=replace-with-a-long-random-secret
TOKEN_ISSUER=auth-system

# Email (Gmail app password)
EMAIL_FROM=replace-with-the-sender-address
EMAIL_APP_PASSWORD=replace-with-a-gmail-app-password

# PostgreSQL connection string
DB_CONNECTION=postgres://user:password@localhost:5432/auth_system

# Redis connection
REDIS_URL="redis://host:port"
REDIS_USER=
REDIS_PASSWORD=